rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User document & all user subcollections (subscriptions, members, sharing_platforms, etc.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Subscriptions collection group for participants query ("Participo en")
    match /{path=**}/subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids ||
        resource.data.userId == request.auth.uid
      );
    }

    // Invites collection for claiming slots
    match /invites/{code} {
      // Se puede leer UNA invitación conociendo su código (get), pero no listar ni consultar la colección.
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Chats and chat messages
    match /chats/{chatId} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == resource.data.ownerUid ||
        request.auth.uid == resource.data.clientUid ||
        request.auth.uid == request.resource.data.ownerUid ||
        request.auth.uid == request.resource.data.clientUid
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid == resource.data.ownerUid ||
          request.auth.uid == resource.data.clientUid
        );
        allow write: if isSignedIn() && (
          request.auth.uid == request.resource.data.ownerUid ||
          request.auth.uid == request.resource.data.clientUid ||
          request.auth.uid == request.resource.data.senderId ||
          request.auth.uid == resource.data.ownerUid ||
          request.auth.uid == resource.data.clientUid ||
          request.auth.uid == resource.data.senderId
        );
      }
    }
  }
}
